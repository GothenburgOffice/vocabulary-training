# Copy to .env before starting any stack: cp .env.example .env
# (PowerShell: Copy-Item .env.example .env). Never commit .env.
# Only POSTGRES_PASSWORD is required. Use a long, random URL-safe password
# (letters, digits, - and _): it is also placed in the database URL.
# PostgreSQL reads it only when it first creates its volume.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
APP_PORT=3420
APP_ORIGIN=http://localhost:3420
# Optional extra exact origins, comma-separated (other domains, http://127.0.0.1).
# Blank means none. A malformed entry makes the app answer 503 until it is fixed.
APP_ORIGIN_ALIASES=http://127.0.0.1:3420
# Optional for compose.images.yaml: pin a published sha-... tag or digest.
# VOCABULARY_IMAGE=ghcr.io/gothenburgoffice/vocabulary-training:latest

# Accounts and admin. Registration starts closed: the privacy details are saved at
# /admin (stored in the database, not here), and public registration is switched on
# there too, once they're real. Hosted registration requires HTTPS; HTTP is accepted
# only on a local address. The dev stack always allows registration.
# Encrypts secrets saved at /admin, such as the Requesty API keys. 32 random bytes,
# base64: openssl rand -base64 32. Changing it makes stored secrets unreadable.
SETTINGS_ENCRYPTION_KEY=
# First admin for /admin, created on start while no admin exists (an existing account
# with this email is promoted, password unchanged). The password needs 12 to 4096
# characters. Ignored once an admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Leave empty for conservative shared rate limiting. Set ONLY when your reverse
# proxy overwrites this header and the app origin cannot be accessed directly.
AUTH_TRUSTED_IP_HEADER=

# Development only (compose.dev.yaml and the devcontainer). The dev database starts
# with registration open and a clearly fake privacy contact; edit them at /admin.
# The dev server polls for file changes, needed on a Windows drive. Set false on
# Linux or macOS to save CPU.
# WATCHPACK_POLLING=true
# Devcontainer only: where Claude Code's project memory lives on the host.
# Default: ~/.claude-memory/vocabulary-training (Windows: %USERPROFILE%\.claude-memory\...).
# CLAUDE_MEMORY_DIR=

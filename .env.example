# Copy to .env. Never commit .env.
# Use a long, random URL-safe password (letters, digits, - and _).
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
APP_PORT=3420
APP_ORIGIN=http://localhost:3420
# More origins the app also answers on, comma-separated, e.g. domain aliases:
# APP_ORIGIN_ALIASES=https://www.example.com,https://example.org
APP_ORIGIN_ALIASES=http://127.0.0.1:3420
# Allow new accounts. Turn off again once your accounts exist.
ALLOW_REGISTRATION=false
# First admin account, created on start while no admin exists (an existing account
# with this email is promoted instead, keeping its password). 12 to 4096 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional for compose.images.yaml: pin a published sha-... tag or digest.
# VOCABULARY_IMAGE=ghcr.io/gothenburgoffice/vocabulary-training:latest

# Encrypts the Requesty API keys saved in the admin area (AI settings). 32 random bytes,
# base64: openssl rand -base64 32. If it changes, re-enter the keys there.
SETTINGS_ENCRYPTION_KEY=

# Dev stack (compose.dev.yaml): the dev server polls for file changes, needed on a
# Windows drive. Set false on Linux or macOS to save CPU.
# WATCHPACK_POLLING=true

# Dev container only (.devcontainer/compose.yaml).
# Where Claude Code's project memory lives on the host.
# Default: ~/.claude-memory/vocabulary-training (Windows: %USERPROFILE%\.claude-memory\...).
# CLAUDE_MEMORY_DIR=

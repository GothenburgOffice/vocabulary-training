# Copy to .env. Never commit .env.
# Use a long, random URL-safe password (letters, digits, - and _).
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Allow new accounts. Turn off again once your accounts exist.
ALLOW_REGISTRATION=false
# Optional for compose.images.yaml: pin a published sha-... tag or digest.
# VOCABULARY_IMAGE=ghcr.io/gothenburgoffice/vocabulary-training:latest

# Optional AI language notes and word audio (see docs/ai-features.md).
# Keys are server-only: keep them in .env, never in source or a NEXT_PUBLIC_ variable.
# Basic tier, used by every account. A blank key turns AI off for basic accounts.
REQUESTY_API_KEY=
REQUESTY_MODEL=novita/ling-3.1-flash
REQUESTY_SPEECH_MODEL=deepinfra/XiaomiMiMo/MiMo-V2.5-tts
REQUESTY_SPEECH_VOICE=Mia
# When false, models without known zero pricing are refused.
REQUESTY_ALLOW_PAID_MODELS=false

# Plus tier, for accounts with users.ai_tier = 'plus'. Blank settings use the basic
# value; with no plus key, plus accounts use the basic tier.
REQUESTY_PLUS_API_KEY=
REQUESTY_PLUS_MODEL=
REQUESTY_PLUS_SPEECH_MODEL=
REQUESTY_PLUS_SPEECH_VOICE=
REQUESTY_PLUS_ALLOW_PAID_MODELS=false

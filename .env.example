# Copy to .env. Never commit .env.
# Use a long, random URL-safe password (letters, digits, - and _).
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Open registration intentionally. Close again after creating your accounts.
ALLOW_REGISTRATION=false
# Optional for compose.images.yaml: pin a published sha-... tag or digest.
# VOCABULARY_IMAGE=ghcr.io/gothenburgoffice/vocabulary-training:latest
# Optional text comments and click-to-play audio. Blank key disables both.
# Put your own key only in .env, never in source or a NEXT_PUBLIC_ variable.
REQUESTY_API_KEY=
# Direct free model observed under the current ZDR restriction; no paid fallback.
REQUESTY_MODEL=novita/ling-3.1-flash
REQUESTY_ALLOW_PAID_MODELS=false
# Per-process limits reset on restart. Also restrict the key in Requesty.
REQUESTY_DAILY_LIMIT=200
# Demo pronunciation voice, best for English; other languages may be inaccurate.
REQUESTY_SPEECH_MODEL=deepinfra/XiaomiMiMo/MiMo-V2.5-tts
REQUESTY_SPEECH_VOICE=Mia
REQUESTY_SPEECH_DAILY_LIMIT=200

# Copy to .env. Never commit .env.
# Use a long, random URL-safe password (letters, digits, - and _).
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Open registration intentionally. Close again after creating your accounts.
ALLOW_REGISTRATION=false
# Optional for compose.images.yaml: pin a published sha-... tag or digest.
# VOCABULARY_IMAGE=ghcr.io/hkarn/vocabulary-training:latest
